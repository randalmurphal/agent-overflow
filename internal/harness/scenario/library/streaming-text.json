{
  "version": 1,
  "name": "streaming-text",
  "description": "Claude turn that streams a short assistant reply as text deltas, then completes. The zero-config default for claude mocks. (system/init and the user echo are adapter-emitted, not scenario lines.)",
  "provider": "claude",
  "turns": [
    {
      "label": "streamed-reply",
      "steps": [
        {
          "emit": {
            "delayBetweenMs": 40,
            "lines": [
              "{\"type\":\"stream_event\",\"event\":\"message_start\",\"data\":{\"type\":\"message_start\",\"message\":{\"id\":\"msg-${TURN}\",\"role\":\"assistant\"}}}",
              "{\"type\":\"stream_event\",\"event\":\"content_block_start\",\"data\":{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"text\",\"text\":\"\"}}}",
              "{\"type\":\"stream_event\",\"event\":\"content_block_delta\",\"data\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"Hello! \"}}}",
              "{\"type\":\"stream_event\",\"event\":\"content_block_delta\",\"data\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"This reply is streaming \"}}}",
              "{\"type\":\"stream_event\",\"event\":\"content_block_delta\",\"data\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"from the mock provider (turn ${TURN}).\"}}}",
              "{\"type\":\"stream_event\",\"event\":\"content_block_stop\",\"data\":{\"type\":\"content_block_stop\",\"index\":0}}",
              "{\"type\":\"stream_event\",\"event\":\"message_stop\",\"data\":{\"type\":\"message_stop\"}}",
              "{\"type\":\"assistant\",\"message\":{\"id\":\"msg-${TURN}\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Hello! This reply is streaming from the mock provider (turn ${TURN}).\"}]}}",
              "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false}"
            ]
          }
        }
      ]
    }
  ],
  "afterTurns": "repeatLast"
}
