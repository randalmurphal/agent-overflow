{
  "version": 1,
  "name": "codex-collab-parallel-children",
  "description": "MultiAgentV2 with two children spawned in one parent turn, both answering into that same turn. Every envelope carries the same passthrough turn id, so this covers G1's cross-child face: each child's FINAL_ANSWER must land on ITS OWN spawn card. Expect two spawn cards, one completion row each, with the right payload on each.",
  "provider": "codex",
  "turns": [
    {
      "label": "two-children-two-answers",
      "steps": [
        {
          "emit": {
            "delayBetweenMs": 40,
            "lines": [
              "{\"jsonrpc\":\"2.0\",\"method\":\"turn/started\",\"params\":{\"threadId\":\"${THREAD_ID}\",\"turn\":{\"id\":\"${TURN_ID}\"}}}",
              "{\"jsonrpc\":\"2.0\",\"method\":\"rawResponseItem/completed\",\"params\":{\"threadId\":\"${THREAD_ID}\",\"turnId\":\"${TURN_ID}\",\"item\":{\"type\":\"function_call\",\"name\":\"spawn_agent\",\"namespace\":\"collaboration\",\"call_id\":\"call_spawn_reviewer\",\"arguments\":\"{\\\"agent_type\\\":\\\"reviewer\\\",\\\"task_name\\\":\\\"reviewer\\\",\\\"message\\\":\\\"<encrypted>\\\"}\"}}}",
              "{\"jsonrpc\":\"2.0\",\"method\":\"rawResponseItem/completed\",\"params\":{\"threadId\":\"${THREAD_ID}\",\"turnId\":\"${TURN_ID}\",\"item\":{\"type\":\"function_call_output\",\"call_id\":\"call_spawn_reviewer\",\"output\":\"{\\\"agent_id\\\":\\\"child-reviewer\\\",\\\"task_name\\\":\\\"/root/reviewer\\\",\\\"nickname\\\":\\\"reviewer\\\"}\"}}}",
              "{\"jsonrpc\":\"2.0\",\"method\":\"item/completed\",\"params\":{\"threadId\":\"${THREAD_ID}\",\"turnId\":\"${TURN_ID}\",\"item\":{\"type\":\"subAgentActivity\",\"id\":\"call_spawn_reviewer\",\"kind\":\"started\",\"agentThreadId\":\"child-reviewer\",\"agentPath\":\"/root/reviewer\"}}}",
              "{\"jsonrpc\":\"2.0\",\"method\":\"rawResponseItem/completed\",\"params\":{\"threadId\":\"${THREAD_ID}\",\"turnId\":\"${TURN_ID}\",\"item\":{\"type\":\"function_call\",\"name\":\"spawn_agent\",\"namespace\":\"collaboration\",\"call_id\":\"call_spawn_tester\",\"arguments\":\"{\\\"agent_type\\\":\\\"tester\\\",\\\"task_name\\\":\\\"tester\\\",\\\"message\\\":\\\"<encrypted>\\\"}\"}}}",
              "{\"jsonrpc\":\"2.0\",\"method\":\"rawResponseItem/completed\",\"params\":{\"threadId\":\"${THREAD_ID}\",\"turnId\":\"${TURN_ID}\",\"item\":{\"type\":\"function_call_output\",\"call_id\":\"call_spawn_tester\",\"output\":\"{\\\"agent_id\\\":\\\"child-tester\\\",\\\"task_name\\\":\\\"/root/tester\\\",\\\"nickname\\\":\\\"tester\\\"}\"}}}",
              "{\"jsonrpc\":\"2.0\",\"method\":\"item/completed\",\"params\":{\"threadId\":\"${THREAD_ID}\",\"turnId\":\"${TURN_ID}\",\"item\":{\"type\":\"subAgentActivity\",\"id\":\"call_spawn_tester\",\"kind\":\"started\",\"agentThreadId\":\"child-tester\",\"agentPath\":\"/root/tester\"}}}"
            ]
          }
        },
        {
          "delayMs": 120
        },
        {
          "emit": {
            "delayBetweenMs": 40,
            "lines": [
              "{\"jsonrpc\":\"2.0\",\"method\":\"rawResponseItem/completed\",\"params\":{\"threadId\":\"${THREAD_ID}\",\"turnId\":\"${TURN_ID}\",\"item\":{\"type\":\"agent_message\",\"id\":\"amsg-reviewer-${TURN}\",\"author\":\"/root/reviewer\",\"recipient\":\"/root\",\"content\":[{\"type\":\"input_text\",\"text\":\"Message Type: FINAL_ANSWER\\nTask name: /root\\nSender: /root/reviewer\\nPayload:\\nReviewer verdict.\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"${TURN_ID}\"}}}}"
            ]
          }
        },
        {
          "delayMs": 100
        },
        {
          "emit": {
            "delayBetweenMs": 40,
            "lines": [
              "{\"jsonrpc\":\"2.0\",\"method\":\"rawResponseItem/completed\",\"params\":{\"threadId\":\"${THREAD_ID}\",\"turnId\":\"${TURN_ID}\",\"item\":{\"type\":\"agent_message\",\"id\":\"amsg-tester-${TURN}\",\"author\":\"/root/tester\",\"recipient\":\"/root\",\"content\":[{\"type\":\"input_text\",\"text\":\"Message Type: FINAL_ANSWER\\nTask name: /root\\nSender: /root/tester\\nPayload:\\nTester verdict.\"}],\"internal_chat_message_metadata_passthrough\":{\"turn_id\":\"${TURN_ID}\"}}}}"
            ]
          }
        },
        {
          "delayMs": 60
        },
        {
          "emit": {
            "delayBetweenMs": 40,
            "lines": [
              "{\"jsonrpc\":\"2.0\",\"method\":\"turn/completed\",\"params\":{\"threadId\":\"${THREAD_ID}\",\"turn\":{\"id\":\"${TURN_ID}\",\"status\":\"completed\"}}}"
            ]
          }
        }
      ]
    }
  ],
  "afterTurns": "repeatLast"
}
