{
  "version": 1,
  "name": "tool-approval",
  "description": "Claude turn that requests CanUseTool approval for a Bash command; allow runs the tool, deny apologizes. Exercises the approval round trip.",
  "provider": "claude",
  "turns": [
    {
      "label": "gated-bash",
      "steps": [
        {
          "approval": {
            "toolName": "Bash",
            "input": {"command": "rm -rf build/"},
            "onAllow": [
              {
                "emit": {
                  "delayBetweenMs": 60,
                  "lines": [
                    "{\"type\":\"assistant\",\"message\":{\"id\":\"msg-tool-${TURN}\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"tu-${TURN}\",\"name\":\"Bash\",\"input\":{\"command\":\"rm -rf build/\"}}]}}",
                    "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"tu-${TURN}\",\"content\":\"\"}]}}",
                    "{\"type\":\"stream_event\",\"event\":\"message_start\",\"data\":{\"type\":\"message_start\",\"message\":{\"id\":\"msg-done-${TURN}\",\"role\":\"assistant\"}}}",
                    "{\"type\":\"stream_event\",\"event\":\"content_block_start\",\"data\":{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"text\",\"text\":\"\"}}}",
                    "{\"type\":\"stream_event\",\"event\":\"content_block_delta\",\"data\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"Removed the build directory.\"}}}",
                    "{\"type\":\"stream_event\",\"event\":\"content_block_stop\",\"data\":{\"type\":\"content_block_stop\",\"index\":0}}",
                    "{\"type\":\"stream_event\",\"event\":\"message_stop\",\"data\":{\"type\":\"message_stop\"}}",
                    "{\"type\":\"assistant\",\"message\":{\"id\":\"msg-done-${TURN}\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Removed the build directory.\"}]}}",
                    "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false}"
                  ]
                }
              }
            ],
            "onDeny": [
              {
                "emit": {
                  "delayBetweenMs": 60,
                  "lines": [
                    "{\"type\":\"stream_event\",\"event\":\"message_start\",\"data\":{\"type\":\"message_start\",\"message\":{\"id\":\"msg-deny-${TURN}\",\"role\":\"assistant\"}}}",
                    "{\"type\":\"stream_event\",\"event\":\"content_block_start\",\"data\":{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"text\",\"text\":\"\"}}}",
                    "{\"type\":\"stream_event\",\"event\":\"content_block_delta\",\"data\":{\"type\":\"content_block_delta\",\"delta\":{\"type\":\"text_delta\",\"text\":\"Understood, I won't run that command.\"}}}",
                    "{\"type\":\"stream_event\",\"event\":\"content_block_stop\",\"data\":{\"type\":\"content_block_stop\",\"index\":0}}",
                    "{\"type\":\"stream_event\",\"event\":\"message_stop\",\"data\":{\"type\":\"message_stop\"}}",
                    "{\"type\":\"assistant\",\"message\":{\"id\":\"msg-deny-${TURN}\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Understood, I won't run that command.\"}]}}",
                    "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false}"
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "afterTurns": "repeatLast"
}
