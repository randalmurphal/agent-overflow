{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-overflow.dev/schemas/workflow.schema.json",
  "title": "Agent Overflow Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "phases"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "inputs": {"$ref": "#/$defs/variables"},
    "outputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/workflowOutput"}},
    "non_goals": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "description": "Work this workflow deliberately does not do, carried into every element's prompt alongside the goal chain of the run tree so a long campaign cannot drift its own scope outward one wave at a time."
    },
    "phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phase"}},
    "default_step_mode": {"type": "boolean"},
    "cleanup": {"enum": ["manual", "auto"]}
  },
  "$defs": {
    "variables": {"type": "object", "additionalProperties": {"$ref": "#/$defs/variable"}},
    "variable": {
      "type": "object", "additionalProperties": false, "required": ["schema"],
      "properties": {
        "schema": {"$ref": "#/$defs/jsonSchema"},
        "optional": {"type": "boolean"},
        "window": {
          "description": "Prior attempts a reserved `history.<phase>` input binding carries, most recent kept. Legal on that binding alone; omit for 10.",
          "type": "integer", "minimum": 1, "maximum": 50
        }
      }
    },
    "phaseInputs": {
      "description": "What this phase consumes, keyed by the reference it binds: a workflow input name, a `<phase>.<output>` reference, or the reserved `history.<phase>` binding. Two names are supplied by the engine and must NOT be declared here. `call-depth` (this run's depth in its call tree, 0 for a directly started run) is readable from any prompt, command, or gate predicate without a declaration. `budget` (this run tree's ceiling and spend: `{kind, ceiling, spent, remaining, estimated}`) is readable from any prompt or command without a declaration, but a gate may NOT route on it — have the phase decide and declare that as an output. It is unbound on a run with no ceiling, which is most runs, so `{{budget}}` renders `(not provided)` there.",
      "type": "object", "additionalProperties": {"$ref": "#/$defs/phaseInputVariable"}
    },
    "phaseInputVariable": {
      "description": "A phase input. `schema` may be omitted when the binding is exactly a workflow input name: the phase then inherits that input's schema, which is what keeps a definition from restating one contract once per phase that reads it. Declaring a schema always wins and may narrow the workflow input's; it is never required to match it.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema": {"$ref": "#/$defs/jsonSchema"},
        "optional": {"type": "boolean"},
        "window": {
          "description": "Prior attempts a reserved `history.<phase>` input binding carries, most recent kept. Legal on that binding alone; omit for 10.",
          "type": "integer", "minimum": 1, "maximum": 50
        }
      }
    },
    "jsonSchema": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": {"enum": ["string", "number", "boolean", "array", "object"]},
        "enum": {"type": "array"}, "format": {"type": "string"}, "multiline": {"type": "boolean"}, "description": {"type": "string"},
        "items": {"$ref": "#/$defs/jsonSchema"},
        "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonSchema"}},
        "required": {"type": "array", "items": {"type": "string"}},
        "additionalProperties": {"type": "boolean"},
        "minimum": {"type": "number"}, "maximum": {"type": "number"},
        "minLength": {"type": "integer", "minimum": 0}, "maxLength": {"type": "integer", "minimum": 0},
        "minItems": {"type": "integer", "minimum": 0}, "maxItems": {"type": "integer", "minimum": 0}
      }
    },
    "workflowOutput": {
      "type": "object", "additionalProperties": false, "required": ["from"],
      "properties": {
        "from": {"type": "string"},
        "optional": {
          "description": "This deliverable may be absent when the run completes. A REQUIRED output that its completion path never produced fails the run at the moment it finishes, which is correct for a value a caller routes on and wrong for one a branch of the graph simply does not produce. The dry-run reports a required output whose source phase is not on every path to done (`workflow.output-unreachable`).",
          "type": "boolean"
        },
        "artifact": {"type": "boolean"}
      }
    },
    "effort": {
      "description": "Reasoning tier for an agent turn. Which tiers a given model actually advertises is provider-owned and partly live, so a tier the model does not support is coerced to its default at run time rather than rejected here.",
      "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
    },
    "phase": {
      "type": "object", "additionalProperties": false, "required": ["id", "gate"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "name": {"type": "string"},
        "driver": {"enum": ["agent", "tool"]}, "shape": {"enum": ["single", "fan-out", "call"]},
        "provider": {"type": "string"}, "model": {"type": "string"},
        "effort": {"$ref": "#/$defs/effort"}, "prompt": {"type": "string"},
        "watchdog": {"type": "string"},
        "inputs": {"$ref": "#/$defs/phaseInputs"}, "outputs": {"$ref": "#/$defs/variables"},
        "check": {"type": "string"}, "command": {"type": "string"},
        "resources": {"type": "array", "items": {"type": "string"}},
        "commands": {"type": "array", "items": {"type": "string"}},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "mcp": {"type": "array", "items": {"type": "string"}},
        "grants": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["start-run", "schedule", "update-notes", "introspect", "resolve", "remote-commands"]}
        },
        "access": {"enum": ["read-only", "write"]},
        "fan_out": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
        "over": {"type": "string"}, "as": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "unit": {"$ref": "#/$defs/unit"},
        "join": {"$ref": "#/$defs/unit"},
        "call": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "args": {"type": "object", "additionalProperties": {"type": "string"}},
        "max_depth": {"type": "integer", "minimum": 1},
        "gate": {"$ref": "#/$defs/gate"}
      },
      "not": {
        "anyOf": [
          {"required": ["fan_out", "over"]},
          {"required": ["fan_out", "as"]},
          {"required": ["fan_out", "unit"]}
        ]
      },
      "dependentRequired": {
        "over": ["as", "unit"], "as": ["over", "unit"], "unit": ["over", "as"]
      },
      "allOf": [
        {
          "if": {"properties": {"shape": {"const": "call"}}, "required": ["shape"]},
          "then": {
            "required": ["call"],
            "not": {"anyOf": [
              {"required": ["driver"]}, {"required": ["provider"]}, {"required": ["model"]},
              {"required": ["effort"]},
              {"required": ["prompt"]}, {"required": ["watchdog"]}, {"required": ["inputs"]},
              {"required": ["outputs"]}, {"required": ["check"]}, {"required": ["command"]},
              {"required": ["resources"]}, {"required": ["commands"]}, {"required": ["capabilities"]},
              {"required": ["mcp"]}, {"required": ["grants"]}, {"required": ["access"]}, {"required": ["fan_out"]},
              {"required": ["over"]}, {"required": ["as"]}, {"required": ["unit"]}, {"required": ["join"]}
            ]}
          },
          "else": {
            "not": {"anyOf": [
              {"required": ["call"]}, {"required": ["args"]}, {"required": ["max_depth"]}
            ]}
          }
        },
        {
          "if": {"properties": {"shape": {"const": "fan-out"}}, "required": ["shape"]},
          "then": {
            "required": ["join"],
            "not": {"anyOf": [
              {"required": ["driver"]}, {"required": ["provider"]}, {"required": ["model"]},
              {"required": ["effort"]},
              {"required": ["prompt"]}, {"required": ["check"]}, {"required": ["command"]},
              {"required": ["commands"]}, {"required": ["access"]}
            ]}
          }
        },
        {
          "if": {
            "not": {"anyOf": [
              {"properties": {"shape": {"const": "call"}}, "required": ["shape"]},
              {"properties": {"shape": {"const": "fan-out"}}, "required": ["shape"]}
            ]}
          },
          "then": {"required": ["driver"]}
        },
        {
          "if": {"properties": {"driver": {"const": "tool"}}, "required": ["driver"]},
          "then": {
            "not": {"anyOf": [
              {"required": ["provider"]}, {"required": ["model"]},
              {"required": ["effort"]}, {"required": ["prompt"]}
            ]}
          }
        }
      ]
    },
    "unit": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "provider": {"type": "string"}, "model": {"type": "string"},
        "effort": {"$ref": "#/$defs/effort"},
        "prompt": {"type": "string"}, "command": {"type": "string"}, "access": {"enum": ["read-only", "write"]},
        "resources": {"type": "array", "items": {"type": "string"}},
        "call": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "args": {"type": "object", "additionalProperties": {"type": "string"}},
        "max_depth": {"type": "integer", "minimum": 1},
        "outputs": {"$ref": "#/$defs/variables"},
        "accounts_for_units": {
          "type": "boolean",
          "description": "Hold this join's done envelope to naming every unit of the fan-out exactly once, in a merged array of unit ids or a blocked array of {unit, reason} — the phase must declare both outputs, and a unit missing from both is refused as ordinary envelope-validation feedback. Valid on a join only."
        }
      },
      "allOf": [
        {
          "if": {"required": ["call"]},
          "then": {
            "not": {"anyOf": [
              {"required": ["provider"]}, {"required": ["model"]}, {"required": ["effort"]},
              {"required": ["prompt"]},
              {"required": ["command"]}, {"required": ["access"]}, {"required": ["outputs"]},
              {"required": ["resources"]}, {"required": ["accounts_for_units"]}
            ]}
          },
          "else": {
            "not": {"anyOf": [{"required": ["args"]}, {"required": ["max_depth"]}]}
          }
        }
      ]
    },
    "gate": {
      "type": "object", "additionalProperties": false, "required": ["routes"],
      "properties": {"routes": {"type": "array", "items": {"$ref": "#/$defs/route"}}}
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "when": {"$ref": "#/$defs/predicate"}, "to": {"type": "string"}, "loop": {"type": "string"},
        "max": {"$ref": "#/$defs/loopBound"}, "feedback": {"type": "array", "items": {"type": "string"}},
        "park": {"type": "string"}, "human": {"$ref": "#/$defs/human"},
        "notify": {
          "type": "boolean",
          "description": "Wake the run's bound thread when the gate takes this route, without parking: the run continues exactly as it would have. Not valid on a human or park route, which already wake by parking, and inert on a route to done or failed, where the run's resting wake already reports it."
        },
        "session": {
          "enum": ["fresh", "continue"],
          "description": "Whether the attempt this loop creates runs on the target phase's own previous session (continue) or on a new one (fresh, the default). Valid only on a loop route, and only where the target runs one session of its own — not a tool, call, or fan-out phase. Use continue on a fix edge, where re-entering cold loses what the phase just tried; leave review phases fresh, where remembering the last verdict is the anchoring the loop exists to break. A previous session that is gone falls back to fresh with the fact recorded on the attempt."
        },
        "prompt": {
          "type": "string",
          "description": "Sibling-relative prompt file that replaces the authored body of the phase this loop re-enters, for the one attempt this route creates. Valid only on a loop route whose target runs one session of its own. It is route-scoped and never sticky: an attempt that loops again through a route with no prompt renders the phase's own body. The file resolves, inlines, and freezes exactly like a phase prompt, and its template is checked against the TARGET phase's inputs."
        }
      }
    },
    "human": {
      "type": "object", "additionalProperties": false, "required": ["approve", "reject"],
      "properties": {"approve": {"type": "string", "minLength": 1}, "reject": {"$ref": "#/$defs/loopTarget"}}
    },
    "loopTarget": {
      "type": "object", "additionalProperties": false, "required": ["loop", "max"],
      "properties": {
        "loop": {"type": "string"}, "max": {"$ref": "#/$defs/loopBound"},
        "feedback": {"type": "array", "items": {"type": "string"}}
      }
    },
    "loopBound": {
      "description": "How many times this loop may be traversed: a literal count, or the name of a variable the run resolves the count from when the gate evaluates. A reference must name a number-typed variable that is in scope and resolves to a whole number of at least one.",
      "anyOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]
    },
    "comparison": {
      "type": "object", "additionalProperties": false, "required": ["ref", "value"],
      "properties": {"ref": {"type": "string"}, "value": {}}
    },
    "membership": {
      "type": "object", "additionalProperties": false, "required": ["ref", "values"],
      "properties": {"ref": {"type": "string"}, "values": {"type": "array", "minItems": 1}}
    },
    "predicate": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "eq": {"$ref": "#/$defs/comparison"}, "neq": {"$ref": "#/$defs/comparison"},
        "gt": {"$ref": "#/$defs/comparison"}, "gte": {"$ref": "#/$defs/comparison"},
        "lt": {"$ref": "#/$defs/comparison"}, "lte": {"$ref": "#/$defs/comparison"},
        "in": {"$ref": "#/$defs/membership"}, "exists": {"type": "string"},
        "all": {"type": "array", "items": {"$ref": "#/$defs/predicate"}},
        "any": {"type": "array", "items": {"$ref": "#/$defs/predicate"}},
        "not": {"$ref": "#/$defs/predicate"}
      }
    }
  }
}
