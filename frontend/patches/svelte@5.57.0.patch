new file mode 100644
index 0000000..95f077b
--- /dev/null
+++ b/src/internal/client/flush-caps.js
@@ -0,0 +1,63 @@
+/**
+ * PATCH(agent-overflow flush-loop-caps): bounds for the two unbounded
+ * synchronous flush loops, plus the error they raise.
+ *
+ * Both `flushSync`'s outer `while (true)` and `flush_tasks`'s drain loop are
+ * written as "keep going until there is nothing left", and neither has a
+ * counter. `Batch.#process` DOES have one (`flush_count > 1000` ->
+ * `infinite_loop_guard`), but `Batch.flush`'s `finally` resets `flush_count`
+ * to 0, so a cycle that produces exactly one batch per `flushSync` lap never
+ * accumulates a count and spins forever inside a single macrotask: one core
+ * pegged, no paint, no error, nothing in any log. That is the shape of the
+ * 8-minute WebView2 renderer freeze this hunk exists for.
+ *
+ * The caps are deliberately far above anything the app can legitimately
+ * reach, so tripping one is a bug report rather than a tuning parameter.
+ * Reaching one ABORTS the flush — the wedge is not survivable by
+ * definition, and continuing would just re-enter it — and the thrown error
+ * reaches `window.onerror`, where `utils/frontendErrorCapture.ts` persists
+ * it to `ui-trace/frontend-errors.jsonl`.
+ */
+
+/**
+ * Max laps of `flushSync`'s outer loop. Each lap is a full microtask drain
+ * plus a batch flush; a settling app needs a handful (the deepest observed
+ * in-app cascade is single digits).
+ */
+export const FLUSH_SYNC_MAX_LAPS = 1000;
+
+/**
+ * Max TASKS (not rounds) run by one `flush_tasks` drain. Counting tasks
+ * rather than rounds means the bound has to clear whatever a legitimate
+ * flush queues, and `queue_micro_task` is called roughly per mounted
+ * element-ish unit — bounded in this app by the virtualizer's mounted
+ * window (dozens of rows), not by thread length. 50k leaves ~3 orders of
+ * magnitude of headroom while still bounding a self-re-queueing task.
+ */
+export const FLUSH_TASKS_MAX_TASKS = 50_000;
+
+/**
+ * Abort a wedged flush loop.
+ *
+ * Modelled on `errors.js#effect_update_depth_exceeded` (same `Error` shape
+ * and `name`, so svelte's own boundary/DEV handling treats it identically),
+ * with one deliberate divergence: the message is present in production too.
+ * Svelte can drop it because `https://svelte.dev/e/<code>` documents the
+ * error; this one has no such page, and the whole point of the hunk is that
+ * the captured production record says which loop wedged.
+ *
+ * @param {'flushSync' | 'flush_tasks'} loop
+ * @param {number} limit
+ * @returns {never}
+ */
+export function flush_loop_exceeded(loop, limit) {
+	const error = new Error(
+		`flush_loop_exceeded\nSvelte's \`${loop}\` loop did not settle after ${limit} ${
+			loop === 'flushSync' ? 'laps' : 'tasks'
+		}. A reactive cycle is producing new work on every iteration; the flush was aborted to release the main thread. (agent-overflow patch: patches/svelte@5.57.0.patch, hunk flush-loop-caps)`
+	);
+
+	error.name = 'Svelte error';
+
+	throw error;
+}
