     padding: 0; /* 2 */
-    border: 0 solid; /* 3 */
+    /* Agent Overflow patch (mirrored in preflight.css): upstream writes
+       `border: 0 solid`. The shorthand also resets the five border-image-*
+       longhands, and Blink's generated border-image builder copies a
+       NinePieceImageData for every element style it applies them to
+       (measured 2026-09-18: ~2300 copies per timeline mount, 18% of the
+       Oilpan garbage of a thread switch). Width and style here, color in
+       its own rule after the html rule: Tailwind merges adjacent rules with
+       one selector list and Lightning CSS then folds width + style + color
+       back into the shorthand; neither touches separated rules. Only the
+       border-image-* longhands are no longer reset; nothing in the app or
+       the UA sheets sets them.
+       frontend/src/styles/appCssPipeline.test.ts pins the emitted CSS. */
+    border-width: 0; /* 3 */
+    border-style: solid; /* 3 */
   }
 
