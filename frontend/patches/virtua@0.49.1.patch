+  // PATCH(agent-overflow manual-scroll-marking): sync manual-scroll
+  // marking for external scroll controllers.
+  //
+  // The store classifies any scroll event as USER scrolling unless its
+  // internal manual flag is set: ACTION_SCROLL latches a scroll direction,
+  // and while the latched direction is "forward" $getRange(bufferSize)
+  // drops the entire backward overscan, unmounting every buffered row
+  // before the viewport. The built-in scrollTo/scrollBy/scrollToIndex set
+  // the flag via ACTION_MANUAL_SCROLL before writing scrollTop, but they
+  // are async convergence loops (await + retry + settle timers) — unusable
+  // for the sync per-frame pin writes of an external stick-to-bottom
+  // controller. This exposes the same one-line marking so such a
+  // controller can tell virtua "the write that follows is not the user".
+  // The store clears the flag on scrollend (ACTION_SCROLL_END), so callers
+  // must mark before EVERY programmatic write. The literal 7 is the
+  // core's internal ACTION_MANUAL_SCROLL constant (lib/core/index.js
+  // $update case 7, minified body `_ = 1`), which the minified core does
+  // not export.
+  export const markProgrammaticScroll = (() => {
+    store.$update(7);
+  }) satisfies VirtualizerHandle["markProgrammaticScroll"] as VirtualizerHandle["markProgrammaticScroll"];
+  // PATCH(agent-overflow scroll-applier): route the internal scroll-jump
+  // compensation write ($fixScrollJump) through an external applier.
+  //
+  // When an above-viewport (or viewport-spanning) row remeasures, virtua
+  // compensates by writing scrollTop DIRECTLY from inside createScroller's
+  // observer callback - a second scrollTop writer that an external scroll
+  // controller cannot see semantically (it observes only the resulting
+  // anonymous scroll event). Registering an applier hands that write to the
+  // controller instead: the applier receives the absolute rounded target
+  // plus the raw (jump, shift) pair, synchronously in the same call (it runs
+  // post-flush pre-paint; deferring would paint one uncompensated frame).
+  // Contract: return true after writing scrollTop itself - any value is safe
+  // because the store re-syncs from the resulting scroll event; return false
+  // to decline, and the core pokes its store with the current DOM offset
+  // (ACTION_MANUAL_SCROLL then ACTION_SCROLL, exactly like the
+  // scheduled-scroll path - the manual mark defeats the same-offset native
+  // early-break so the poke always clears the flushed jump) so a declined
+  // write can never desync the store (unlike external suppression of the
+  // direct write, which swallows the scroll event the model relies on).
