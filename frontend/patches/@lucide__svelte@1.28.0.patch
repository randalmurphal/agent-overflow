+  const key = `${name ?? body}|${strokeWidth}`;
+  const hit = maskCache.get(key);
+  if (hit !== undefined) return hit;
+  const id = `ao-lucide-${seq++}`;
+  const markup =
+    `<mask id="${id}" maskUnits="objectBoundingBox" maskContentUnits="objectBoundingBox" style="mask-type:alpha">` +
+    `<g transform="scale(${1 / 24})" fill="none" stroke="black" stroke-width="${strokeWidth}"` +
+    ` stroke-linecap="round" stroke-linejoin="round">${body}</g></mask>`;
+  maskMarkup.push(markup);
+  ensureSpriteRoot().insertAdjacentHTML('beforeend', markup);
+  const ref = `url(#${id})`;
+  maskCache.set(key, ref);
+  return ref;
+}
