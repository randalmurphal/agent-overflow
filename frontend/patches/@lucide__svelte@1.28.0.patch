+// into one hidden <svg> of <mask> elements), NOT a data-URI image: Blink
+// builds an isolated SVG document — internal page, LocalDOMWindow, and its
+// full singleton roster — per DISTINCT image URI, and the app's ~47 icon
+// URIs held ~57 such documents alive whose tiny long-lived singletons pinned
+// hundreds of near-empty 128KB Oilpan pages (the renderer floor ratchet,
+// measured 2026-08-25). Masks are mask-type:alpha (the semantics the data
+// URIs had under mask-mode: match-source) with objectBoundingBox units and
+// the 24-unit content scaled to the unit square, which matches the old
+// `mask-size: contain` rendering on these square spans. This mirrors the
+// app's utils/maskSprite.ts; it is deliberately self-contained because a
+// vendor patch cannot import app code.
+//
+// Dropped relative to upstream: `color` now flows through CSS currentColor
+// only (upstream stamped it on the svg's stroke; no app call site passes it),
+// and `children` snippets are not rendered (no app call site passes one; a
+// mask has no DOM to append to).
+const maskCache = new Map<string, string>();
+const maskMarkup: string[] = [];
+let spriteRoot: SVGSVGElement | undefined;
+let seq = 0;
+
+function ensureSpriteRoot(): SVGSVGElement {
+  if (spriteRoot === undefined || !spriteRoot.isConnected) {
+    spriteRoot = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+    spriteRoot.setAttribute('width', '0');
+    spriteRoot.setAttribute('height', '0');
+    spriteRoot.setAttribute('aria-hidden', 'true');
+    spriteRoot.setAttribute('data-mask-sprite', 'lucide');
+    spriteRoot.style.position = 'absolute';
+    // A replaced root would orphan every registered mask, so rebuild them all.
+    if (maskMarkup.length) spriteRoot.innerHTML = maskMarkup.join('');
+    document.body.appendChild(spriteRoot);
+  }
+  return spriteRoot;
+}
+
+function maskRef(
+  name: string | undefined,
+  iconNode: [string, Record<string, string>][],
+  strokeWidth: number | string,
+): string {
+  let body = '';
+  for (const [tag, attrs] of iconNode) {
+    body += `<${tag}`;
+    for (const [k, v] of Object.entries(attrs)) body += ` ${k}="${v}"`;
+    body += '/>';
