{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["svelte"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "src/**/*.svelte", "bindings/**/*"],
  "exclude": ["node_modules"]
}
