{
	"name": "svelte-streamdown",
	"version": "3.1.2",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/beynar/svelte-streamdown.git"
	},
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./mermaid": {
			"types": "./dist/Elements/Mermaid.svelte.d.ts",
			"svelte": "./dist/Elements/Mermaid.svelte"
		},
		"./math": {
			"types": "./dist/Elements/Math.svelte.d.ts",
			"svelte": "./dist/Elements/Math.svelte"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"katex": "^0.16.22",
		"marked": "^16.2.1",
		"mermaid": "^11.15.0",
		"tailwind-merge": "^3.3.1"
	}
}
