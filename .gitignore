# Build
build/bin/
frontend/dist/
bin/
dist/
# ...except inside frontend/vendor/. An npm tarball ships a package's code
# AS `dist/` (that is the published layout, not a build output), so for a
# vendored package that tree is checked-in SOURCE — we edit it in place.
# The blanket `dist/` above would silently leave every vendored package as
# an empty directory in git. The negation has to re-include the DIRECTORY:
# git will not look inside an excluded parent, so `!.../dist/**` alone
# would not work.
!frontend/vendor/*/dist/

# Task runner cache
.task/

# Dependencies
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Go
*.exe
*.test
*.out

# Ralph loop logs
ralph-*.log

# Build artifacts
frontend/package.json.md5
/build/linux/agent-overflow.desktop
.claude/
.playwright-mcp

# Vitest browser-mode byproducts (failure screenshots / attachments).
# Generation is suppressed via browser.screenshotFailures:false in
# vitest.config.ts; this is a belt-and-braces guard. Intentional
# visual-regression baselines, if ever added, live in committed
# __screenshots__/ dirs (deliberately NOT ignored here).
frontend/.vitest-attachments/

# Binaries built into the repo root
/agent-overflow
/db-rebake
/dump-schema

# Stale Wails v2 bindings — current bindings live in frontend/bindings/
frontend/wailsjs/

# Freeze-replay corpus. A verbatim capture of one real session's streamed
# payloads, pulled out of the local SQLite store by
# frontend/scripts/generate-freeze-replay-fixture.mjs. It is somebody's actual
# code and conversation — never committable, under any circumstances.
# frontend/src/lib/markdown/freezeReplay.manual.ts skips its corpus suites
# when the file is absent, so nothing breaks without it.
frontend/src/lib/markdown/__fixtures__/freezeReplay.fixture.json

# Freeze-reproduction fixtures + captured renderer evidence, driven by
# e2e/tests/freeze-repro.manual.spec.ts. Same rule as the corpus above:
# e2e/scripts/generate-freeze-repro.mjs pulls the verbatim text of one real
# session (prose, tool inputs, every byte of command output) out of the local
# SQLite store, and the evidence dirs hold stacks/profiles/console logs captured
# while replaying it. Never committable, under any circumstances. The spec
# test.skips itself when the directory is absent, so nothing breaks without it.
e2e/fixtures/
