#!/usr/bin/env bash
# Runner for the CDP probes. Online probes exec Windows node.exe; offline ones read a saved file.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT="${AO_CDP_PORT:-9223}"
if [[ ! "$PORT" =~ ^[0-9]+$ ]] || (( 10#$PORT < 1 || 10#$PORT > 65535 )); then
  echo "probe: AO_CDP_PORT must be an integer between 1 and 65535, got: $PORT" >&2
  exit 2
fi
PORT=$((10#$PORT))

list_probes() {
  local f name
  for f in "$DIR"/*.mjs; do
    [ -e "$f" ] || continue
    name="$(basename "$f" .mjs)"
    printf '  %-18s %s\n' "$name" "$(sed -n '1s|^// *||p' "$f")"
  done
}

if [ $# -eq 0 ]; then
  cat <<'USAGE'
usage: scripts/perfprobe/probe <name> [args...]

Drives Chrome DevTools Protocol probes against the WebView2 window of a running
DEBUG=1 dev build. WSL cannot reach Windows loopback, so online probes are staged
into a Windows directory and run there under node.exe. Offline probes read a saved
snapshot or trace and run under WSL node with a raised heap limit.

env:
  AO_CDP_PORT        CDP port (default 9223; the soak rig uses 9224)
  AO_PERFPROBE_OUT   Windows directory for staged scripts and saved output
                     (default %LOCALAPPDATA%\Temp\ao-perfprobe)
  AO_PROBE_MAX_EVENT_BYTES
                     maximum retained CDP event history (default 16 MiB)
  AO_PROBE_MAX_STREAM_BYTES
                     maximum one streamed CDP result (default 512 MiB)
  AO_WINDOWS_NODE_EXE
                     exact WSL path to Windows node.exe for restricted service environments

probes:
USAGE
  list_probes
  exit 0
fi

name="${1%.mjs}"; shift
script="$DIR/$name.mjs"
if [ ! -f "$script" ]; then
  echo "probe: no such probe: $name" >&2
  echo "       run 'scripts/perfprobe/probe' with no arguments for the list" >&2
  exit 1
fi

# Line 3 marks a probe that reads a file instead of talking to CDP, always or behind a flag.
marker="$(sed -n '3p' "$script")"
offline=0
case "$marker" in
  "// offline") offline=1 ;;
  "// offline-with "*)
    flag="${marker#// offline-with }"
    for a in "$@"; do [ "$a" = "$flag" ] && offline=1; done
    ;;
esac

if [ "$offline" -eq 1 ]; then
  if ! command -v node >/dev/null 2>&1; then
    echo "probe: no WSL node on PATH; offline probes need it for the raised heap limit" >&2
    exit 1
  fi
  exec node --max-old-space-size=8192 "$script" "$@"
fi

if [ -z "${AO_PERFPROBE_MANIFEST:-}" ] && [ -z "${AO_PERFPROBE_INSTANCE_MANIFEST:-}" ]; then
  echo "probe: online probes require AO_PERFPROBE_MANIFEST from the run supervisor" >&2
  echo "       refusing an unowned CDP endpoint" >&2
  exit 2
fi

NODE_EXE="${AO_WINDOWS_NODE_EXE:-$(command -v node.exe 2>/dev/null || true)}"
if [ -z "$NODE_EXE" ]; then
  win_node="$(powershell.exe -NoProfile -Command "(Get-Command node).Source" 2>/dev/null | tr -d '\r')"
  [ -n "$win_node" ] && NODE_EXE="$(wslpath -u "$win_node" 2>/dev/null || true)"
fi
if [ -z "$NODE_EXE" ] || [ ! -x "$NODE_EXE" ]; then
  echo "probe: no Windows node.exe found. CDP is on Windows loopback and WSL cannot reach it," >&2
  echo "       so the probes need node.exe (Node 22+) on PATH or resolvable via powershell.exe." >&2
  exit 1
fi

OUT_WIN="${AO_PERFPROBE_OUT:-}"
if [ -z "$OUT_WIN" ]; then
  # Run cmd.exe from a Windows-visible cwd so it does not warn about the UNC path.
  localappdata="$(cd /mnt/c && cmd.exe /c 'echo %LOCALAPPDATA%' 2>/dev/null | tr -d '\r')"
  if [ -z "$localappdata" ]; then
    echo "probe: could not resolve %LOCALAPPDATA%; set AO_PERFPROBE_OUT to a Windows path" >&2
    exit 1
  fi
  OUT_WIN="${localappdata}\\Temp\\ao-perfprobe"
fi
OUT_WSL="$(wslpath -u "$OUT_WIN" 2>/dev/null || true)"
if [ -z "$OUT_WSL" ]; then
  echo "probe: AO_PERFPROBE_OUT must be a Windows path, got: $OUT_WIN" >&2
  exit 1
fi

mkdir -p "$OUT_WSL/lib" || exit 1
cp -f "$DIR"/*.mjs "$OUT_WSL/" || exit 1
cp -f "$DIR"/*.ps1 "$OUT_WSL/" || exit 1
cp -f "$DIR"/lib/*.mjs "$OUT_WSL/lib/" || exit 1

cd "$OUT_WSL" || exit 1
WSLENV="${WSLENV:+$WSLENV:}AO_CDP_PORT:AO_PERFPROBE_OUT:AO_PERFPROBE_MANIFEST:AO_PERFPROBE_INSTANCE_MANIFEST:AO_PERFPROBE_LEASE:AO_ALLOC_INTERVAL:AO_PROBE_CALL_TIMEOUT_MS:AO_PROBE_MAX_EVENT_BYTES:AO_PROBE_MAX_STREAM_BYTES" \
AO_CDP_PORT="$PORT" \
AO_PERFPROBE_OUT="$OUT_WIN" \
AO_PERFPROBE_MANIFEST="${AO_PERFPROBE_MANIFEST:-}" \
AO_PERFPROBE_INSTANCE_MANIFEST="${AO_PERFPROBE_INSTANCE_MANIFEST:-}" \
AO_PERFPROBE_LEASE="${AO_PERFPROBE_LEASE:-}" \
AO_ALLOC_INTERVAL="${AO_ALLOC_INTERVAL:-}" \
AO_PROBE_CALL_TIMEOUT_MS="${AO_PROBE_CALL_TIMEOUT_MS:-}" \
AO_PROBE_MAX_EVENT_BYTES="${AO_PROBE_MAX_EVENT_BYTES:-}" \
AO_PROBE_MAX_STREAM_BYTES="${AO_PROBE_MAX_STREAM_BYTES:-}" \
  "$NODE_EXE" "$name.mjs" "$@"
rc=$?
echo "probe: out dir $OUT_WIN  ->  $OUT_WSL"
exit $rc
